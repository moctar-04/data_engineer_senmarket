# Configuration du générateur SenMarket
# Copier ce fichier en .env et ajuster les valeurs

# Volumes (nombre d'enregistrements)
N_CLIENTS=5000
N_VENDEURS=200
N_PRODUITS=1500
N_COMMANDES=20000
N_AVIS=8000
N_EVENTS=50000

# Seed pour reproductibilité (None = aléatoire)
RANDOM_SEED=42

# Chemins de sortie
OUTPUT_DIR=data/raw
CLEANED_DIR=data/cleaned

# Formats d'export (csv,json,parquet — séparés par des virgules)
EXPORT_FORMATS=csv,json,parquet

# Probabilités de défauts (0.0 à 1.0)
P_MISSING=0.03
P_DUPLICATE=0.02
P_INCONSISTENT_DATE=0.01

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/generator.log
